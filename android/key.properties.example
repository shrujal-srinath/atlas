# Copy this file to android/key.properties and fill in your real values.
# android/key.properties is gitignored — NEVER commit it or the .jks keystore.
#
# Create an upload keystore once with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
# then place upload-keystore.jks in android/app/ (or use an absolute storeFile path).

storePassword=your-keystore-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
